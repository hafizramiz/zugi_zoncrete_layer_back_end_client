### 🚀 V2 İçin Nihai JSON Önerisi

Aşağıda tüm önerilerin birleştirildiği profesyonel **V2 Init Response** yapısı bulunmaktadır:

```json
{
"statusCode": 200,
"type": "InitResponseModel",
"message": "OK",

// --- VERSİYONLAMA VE ZAMANLAMA ---
"configHash": "a1b2c3d4e5", // Veya Header'da ETag kullanılır
"serverTime": "2025-11-19T10:00:00Z", // Cihaz saati yanlışsa düzeltmek için

// --- KRİTİK AYARLAR ---
"apiBaseUrl": "https://api.v2.example.com/",
"maintenanceMode": false,

// --- GÜNCELLEME YÖNETİMİ ---
"updateConfig": {
"minSupportedVersion": "1.4.5",
"latestVersion": "1.6.0",
"forceUpdate": false,
"softUpdate": true,
"storeUrl": "market://details?id=com.example.app",
"title": "Yeni Özellikler!",
"message": "Daha hızlı ve güvenli bir deneyim için güncelleyin."
},

// --- FEATURE FLAGS (Özellik Aç/Kapa) ---
"featureFlags": {
"isNewUiEnabled": true,
"isNfcPaymentEnabled": true,
"isDarkThemeEnabled": true,
"showStories": false // Instagram benzeri hikayeler özelliği kapalı
},

// --- YASAL & DESTEK ---
"legalUrls": {
"privacy": "https://example.com/privacy",
"terms": "https://example.com/terms",
"faq": "https://example.com/faq"
},

// --- İÇERİK (ONBOARDING & PREVIEW) ---
"onboardingSlides": [ ... ], // Mevcut yapınız
"previewFeatures": [ ... ]   // Mevcut yapınız
}
```